# Visual Studio / C++ build artifacts
.vs/
[Xx]64/
[Xx]86/
[Dd]ebug/
[Rr]elease/
*.obj
*.pdb
*.ilk
*.idb
*.tlog
*.ipch
*.iobj
*.ipdb
*.log
*.lastbuildstate
*.exp
*.aps

# Intermediate/temp
*/obj/
**/obj/
*.db
*.opendb
*.VC.db
*.suo
*.user

# Build output binaries
*.exe
*.lib

# Blacksmith pack: unused PBR maps (engine only uses BaseColor). Huge (~400MB), exclude.
*_Normal.png
*_ORM.png
*_Mask.png

# Runtime state (changes every run, no need to track)
**/Assets/setting.dat
imgui.ini
debug.txt
build.log
SampleProjectBase/Assets/playtest_log.txt
SampleProjectBase/Docs/Present_1010_技術まとめ.md

# Compiled shaders (regenerated by every build from Shaders/*.hlsl)
*.cso

# Stray MSBuild intermediate folder
SampleProjectBase/SamplePr.*/

# Tools: probe/verification outputs (scripts are kept, their results are not)
SampleProjectBase/Tools/*.png
SampleProjectBase/Tools/*_report.json
SampleProjectBase/Tools/outdoor_validation.json

# SDL3 (third-party import lib is needed to link; *.lib above is for our own build output)
!SampleProjectBase/ThirdParty/**/*.lib

# Licensed assets: used by the game locally, but their licenses forbid redistributing the files.
# (On-Jin SE: no redistribution / purchased packs: no source-file redistribution / parchment: source license unknown)
# See CREDITS.txt. The files stay on disk; only git stops tracking them.
SampleProjectBase/Assets/Sound/
SampleProjectBase/Assets/MM_Blacksmith_Pack/
SampleProjectBase/Assets/Fantasy Props MegaKit[[]Standard[]]/
SampleProjectBase/Assets/Ui/parchment*
SampleProjectBase/Assets/Ui/paper_strip.png
SampleProjectBase/Assets/Ui/selected_button_strip.png